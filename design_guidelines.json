{
  "project_scope": {
    "app_name": "Connectify Arcade - Infinity (Formerly Star Patrol)",
    "target_game": "Star Patrol update renamed to Infinity",
    "genre": "Classic Vertical Space Shooter Arcade Game",
    "core_mechanics": [
      "Vertical touch/pointer & keyboard shooter with auto-firing laser cannon",
      "Sector-based progression system with rising difficulty and multi-wave enemies",
      "Diverse enemy behavior archetypes (Scout Drones, Interceptor Fighters, Heavy Cruisers)",
      "Varied Boss encounters with distinct bullet-hell attack patterns and dynamic health bars",
      "Hangar customization for ship skins, laser beam cosmetics, and stat upgrades (Hull, Cannon, Recovery)",
      "Power-up inventory system (Perisai/Shield, Nova/Blast)",
      "Launch screen, pause state, and post-sector victory/defeat results modal with XP/Peti rewards"
    ]
  },
  "visual_theme": {
    "archetype": "Neon Retro Arcade & Cyber Space",
    "emotional_tone": "High-octane, futuristic, tactile, rewarding, intense retro-arcade space action",
    "color_palette": {
      "background_space": "#0B0E14",
      "background_card": "#121824",
      "background_panel_glass": "rgba(18, 24, 36, 0.85)",
      "border_subtle": "#2A3854",
      "text_primary": "#F4F7F8",
      "text_muted": "#8B9BB4",
      "accent_cyan": "#00F0FF",
      "accent_magenta": "#FF2A85",
      "accent_gold": "#FFB800",
      "accent_mint": "#00FF9D",
      "accent_crimson": "#FF3B30",
      "laser_blue": "#00E5FF",
      "laser_green": "#00FF87",
      "laser_red": "#FF2E63"
    }
  },
  "typography": {
    "headline_font": "Fredoka, sans-serif",
    "body_font": "Outfit, sans-serif",
    "hud_font": "JetBrains Mono, monospace",
    "hierarchy": {
      "hero_title": "text-4xl sm:text-5xl font-bold tracking-tight text-white drop-shadow-[0_0_15px_rgba(0,240,255,0.4)]",
      "section_heading": "text-2xl sm:text-3xl font-semibold text-white",
      "hud_metric": "text-sm sm:text-base font-mono font-bold tracking-wider text-cyan-400",
      "button_text": "text-base font-semibold tracking-wide"
    }
  },
  "layout_and_components": {
    "topbar_hud": {
      "style": "Glassmorphism bar with backdrop-blur-md, border-b border-[#2A3854], fixed max-width 740px",
      "elements": [
        "Back button (data-testid='star-back')",
        "Sector Title & Level Indicator (data-testid='star-title', data-testid='star-level')",
        "Live Score Display (data-testid='star-score')",
        "Pause Toggle Button (data-testid='star-pause')"
      ]
    },
    "flight_arena": {
      "canvas_dimensions": "480x680 responsive vertical field with auto-scaling FIT mode",
      "overlay_hud": {
        "player_health": "data-testid='star-health' (shows current/max HP with heart icons)",
        "wave_counter": "data-testid='star-wave' (GELOMBANG X/3 or BOSS indicator)",
        "elapsed_time": "data-testid='star-time'",
        "boss_health_bar": "data-testid='star-boss-health' (high contrast animated progress bar when Boss is active)",
        "shield_active_badge": "data-testid='star-shield-active'"
      }
    },
    "bottom_power_dock": {
      "style": "2-column power button dock with stock badges and active hover glow",
      "controls": [
        "Shield Powerup Button (data-testid='star-power-shield', stock count data-testid='star-shield-stock')",
        "Nova Blast Powerup Button (data-testid='star-power-blast', stock count data-testid='star-blast-stock')"
      ]
    },
    "launch_screen": {
      "title": "INFINITY ARCADE",
      "subtitle": "Sektor & Rekor Pilot",
      "start_button": "data-testid='star-start' with mint/cyan pill glow",
      "hangar_button": "data-testid='star-open-hangar' for customizing ship & upgrades"
    },
    "hangar_screen": {
      "ship_showcase": "Equipped ship artwork with sector badge & change skin button (data-testid='hangar-cosmetics')",
      "upgrades": [
        "Lambung / Hull Upgrade (data-testid='hangar-upgrade-hull', level data-testid='hangar-level-hull')",
        "Meriam / Cannon Upgrade (data-testid='hangar-upgrade-cannon', level data-testid='hangar-level-cannon')",
        "Pelindung / Recovery Upgrade (data-testid='hangar-upgrade-recovery', level data-testid='hangar-level-recovery')"
      ],
      "actions": "Launch Flight (data-testid='hangar-play') and Buy Upgrades (data-testid='hangar-shop')"
    },
    "results_modal": {
      "elements": [
        "Sector cleared / Defeat message (data-testid='star-result-title')",
        "Final score display (data-testid='star-final-score')",
        "Kills & Bosses summary (data-testid='star-result-summary')",
        "XP and Chest Points rewards (data-testid='star-reward')",
        "Retry / Next Sector button (data-testid='star-retry')",
        "Return to Level Select (data-testid='star-result-menu')"
      ]
    }
  },
